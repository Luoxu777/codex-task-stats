root = true

[*]
insert_final_newline = true
trim_trailing_whitespace = true

[*.ps1]
charset = utf-8-bom
end_of_line = crlf
indent_style = space
indent_size = 4

[*.{md,json,jsonl,yml,yaml,txt}]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2

[{VERSION,LICENSE,.gitignore,.gitattributes,.editorconfig}]
charset = utf-8
end_of_line = lf
